RUNTIME windows=4.0
SYSTEM nt_win
OPTION quiet
FILE {
 src\jnstub.obj
 src\brooms.obj
 src\bldscript.obj
 src\jbhlp.obj
 src\colormap.obj
 src\version-auto.obj
}
LIBRARY jfbuild\engine.lib
LIBRARY jfbuild\build.lib
LIBRARY msvcrt.lib
LIBRARY ole32.lib
LIBRARY user32.lib
LIBRARY gdi32.lib
LIBRARY shell32.lib
LIBRARY ws2_32.lib
LIBRARY comctl32.lib
LIBRARY comdlg32.lib
LIBRARY uxtheme.lib
LIBRARY xinput9_1_0.lib
OPTION eliminate
NAME build.exe
OPTION checksum
OPTION stack=1M
OPTION resource=src\buildres.res
